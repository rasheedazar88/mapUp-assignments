# Base URL of the Go backend (no trailing slash). The WebSocket URL is derived from it
# (http → ws, https → wss) + /ws/alerts.
VITE_API_URL=http://localhost:8080

# Optional: only if the backend runs with API_KEY set (sent as X-API-Key on write requests).
# Note: anything in VITE_* is visible in the browser bundle.
VITE_API_KEY=

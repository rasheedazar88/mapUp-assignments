# Copy to .env (next to docker-compose.yml) to override defaults. All values are optional.

# ---- Database (docker compose) ----
POSTGRES_USER=geofence
POSTGRES_PASSWORD=geofence
POSTGRES_DB=geofence
# Host port for PostGIS (5433 avoids clashing with a locally installed PostgreSQL)
DB_HOST_PORT=5433

# ---- Backend ----
BACKEND_HOST_PORT=8080
# Comma-separated browser origins allowed by CORS and the WebSocket upgrade ("*" = any).
# Passed to the backend container as ALLOWED_ORIGINS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional bonus: when set, POST/PATCH/DELETE require the header X-API-Key: <value>
API_KEY=
# Location updates per second allowed per vehicle, and burst size
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
LOG_LEVEL=info

# Image name used by `docker compose build` / `docker compose push`
BACKEND_IMAGE=geofence-backend:local

# ---- Frontend (only for `docker compose --profile full`) ----
VITE_API_URL=http://localhost:8080

# ---- Backend env when running WITHOUT docker (go run ./cmd/server) ----
# DATABASE_URL=postgres://geofence:geofence@localhost:5433/geofence?sslmode=disable
# PORT=8080
# ALLOWED_ORIGINS=http://localhost:5173
# Integration tests:
# TEST_DATABASE_URL=postgres://geofence:geofence@localhost:5433/geofence?sslmode=disable
